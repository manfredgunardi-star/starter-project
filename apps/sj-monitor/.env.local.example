# .env.local — Local overrides (gitignored, tidak di-commit)
#
# CARA MENGAKTIFKAN EMULATOR:
# 1. Salin file ini → .env.local
#      cp .env.local.example .env.local
#
# 2. Pastikan Java 11+ sudah terinstall:
#      https://adoptium.net/  (download & install Eclipse Temurin 21 LTS)
#      Verifikasi: java -version
#
# 3. Terminal 1 — Start emulator:
#      npm run emulator
#      → Buka http://localhost:4000 untuk Emulator UI
#
# 4. Terminal 2 — Start dev server:
#      npm run dev
#      → App di http://localhost:5173 (semua operasi ke emulator lokal)
#
# HASIL: 0 write ke production Firestore. Aman untuk testing fitur baru.
# ────────────────────────────────────────────────────────────────────────────

VITE_USE_EMULATOR=true
