# Salin ke .env lalu isi oleh Memen. Setelah itu: chmod 600 .env
# JANGAN commit / kirim isi .env ke chat.

# Firebase web config project surat-jalan-monitor
# (Console → Project settings → General → Your apps → Web app → SDK setup and configuration)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=surat-jalan-monitor.firebaseapp.com
FIREBASE_PROJECT_ID=surat-jalan-monitor
FIREBASE_APP_ID=

# Akun bot (user Firebase Auth biasa, role reader di users/{uid})
BOT_EMAIL=
BOT_PASSWORD=

# Bot Telegram pengirim file (default: token bot Hermes, dari /root/.hermes/.env)
TELEGRAM_BOT_TOKEN=
# Chat ID Telegram tujuan (ID user numerik Memen; sama dengan TELEGRAM_ALLOWED_USERS di /root/.hermes/.env)
TELEGRAM_CHAT_ID=
